# Deny local data, history, credentials and repository metadata by default.
**
!*.py
!requirements-hosted.txt
!render.yaml
!hosted/
!hosted/**
!tools/
!tools/test_hosted_postgres.py
!tools/hosted_ci_evidence.py
!tools/hosted_ci.Dockerfile
!tools/hosted_ci.Dockerfile.dockerignore
!tools/run_hosted_ci.sh
!tests/
!tests/fixtures/
!tests/fixtures/schema7.sql
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.db
**/*.sqlite
**/*.sqlite3
